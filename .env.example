# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Project & Environment
PROJECT_NAME="The Lenny Growth Assistant"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Database Configuration
# Default: Local XAMPP MySQL running on localhost:3306
# ------------------------------------------------------------------------------
DB_DRIVER=mysql+pymysql
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lenny_growth_assistant

# Optional: Direct SQLAlchemy connection URL override (supports PostgreSQL or SQLite)
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/lenny_growth_assistant
# Example for MySQL:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/lenny_growth_assistant?charset=utf8mb4

# ------------------------------------------------------------------------------
# AI Inference Provider Configuration
# Options: "ollama" (Local offline inference) | "openai" (Cloud API inference)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama

# OpenAI Configuration (Required only when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama Configuration (Used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Retrieval-Augmented Generation (RAG) Settings
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=4
