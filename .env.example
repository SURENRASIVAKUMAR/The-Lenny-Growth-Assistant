# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Project & Environment
PROJECT_NAME="The Lenny Growth Assistant"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Primary Database Configuration: PostgreSQL (Port 5432)
# Supported drivers: postgresql+psycopg (psycopg 3) or postgresql+psycopg2
# ------------------------------------------------------------------------------
DB_DRIVER=postgresql+psycopg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lenny_growth_assistant

# Direct SQLAlchemy connection URL (Defaults to PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth_assistant

# Preserved MySQL connection URL for data migration
MYSQL_DATABASE_URL=mysql+pymysql://root:@localhost:3306/lenny_growth_assistant

# ------------------------------------------------------------------------------
# Authoritative Knowledge Source & Strict Grounding Settings
# Repository: https://github.com/ChatPRD/lennys-podcast-transcripts
# ------------------------------------------------------------------------------
AUTHORITATIVE_REPO_PATH=data/lennys-podcast-transcripts
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RAG_TOP_K=4
MIN_EVIDENCE_THRESHOLD=0.25

# ------------------------------------------------------------------------------
# AI Inference Provider Configuration
# Options: "ollama" (Local inference) | "openai" (Cloud API) | "demo" (Synthesizer)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama

# OpenAI Configuration (Required only when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama Configuration (Used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=60
